@model FormUygulamasi.ViewModels.CariViewModel
@using FormUygulamasi.Models;

@{
    ViewData["Title"] = "Cari Güncelle";
    var iller = ViewData["Iller"] as List<Il>;
    var ilceler = ViewData["Ilceler"] as List<Ilce>;
}

<h1 class="text-center form-title mb-3">Cari Güncelle</h1>
<div class="form-divider mx-auto mb-4"></div>

<div class="card shadow mx-auto" style="max-width: 950px;">
    <div class="card-body px-5">

        <form asp-controller="Cari" asp-action="CariGuncelle" method="post">

            <input asp-for="Id" type="hidden" />

            <div class="mb-3">
                <div class="row">
                    <div class="col">
                        <label asp-for="CariAdi" class="form-label">Cari Adı</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="CariAdi" class="form-control" placeholder="Cari adını giriniz." />
                        </div>
                        <span asp-validation-for="CariAdi" class="text-danger"></span>
                    </div>

                    <div class="col">
                        <label asp-for="CariSoyadi" class="form-label">Cari Soyadı</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person-badge"></i>
                            </span>
                            <input asp-for="CariSoyadi" class="form-control" placeholder="Cari soyadını giriniz." />
                        </div>
                        <span asp-validation-for="CariSoyadi" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Telefon" class="form-label">Cari Telefon Numarası</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-telephone"></i>
                    </span>
                    <input asp-for="Telefon" class="form-control" placeholder="(555) 555 55 55" />
                </div>
                <span asp-validation-for="Telefon" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="row">
                    <div class="col">
                        <label asp-for="FirmaAdi" class="form-label">Firma Adı</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-building"></i>
                            </span>
                            <input asp-for="FirmaAdi" class="form-control" placeholder="Firma adını giriniz." />
                        </div>
                        <span asp-validation-for="FirmaAdi" class="text-danger"></span>
                    </div>

                    <div class="col">
                        <label asp-for="FirmaVKN" class="form-label">Firma VKN</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-card-text"></i>
                            </span>
                            <input asp-for="FirmaVKN" class="form-control" placeholder="Firma VKN giriniz." />
                        </div>
                        <span asp-validation-for="FirmaVKN" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Kategori" class="form-label">Kategori</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-tags"></i>
                    </span>
                    <input asp-for="Kategori" class="form-control" placeholder="Kategori giriniz." />
                </div>
                <span asp-validation-for="Kategori" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="row">
                    <div class="col">
                        <label asp-for="IlId" class="form-label">İl</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-geo-alt"></i>
                            </span>

                            <select asp-for="IlId" id="ilSelect" class="form-select">
                                <option value="">İl Seçiniz</option>
                                @foreach (var il in iller)
                                {
                                    <option value="@il.IlId">@il.IlAdi</option>
                                }
                            </select>

                        </div>
                        <span asp-validation-for="IlId" class="text-danger"></span>
                    </div>

                    <div class="col">
                        <label asp-for="IlceId" class="form-label">İlçe</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-pin-map"></i>
                            </span>
                            <select asp-for="IlceId" id="ilceSelect" class="form-select">
                                <option value="">İlçe Seçiniz</option>
                                @foreach (var ilce in ilceler)
                                {
                                    <option value="@ilce.IlceId">@ilce.IlceAdi</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="IlceId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Adres" class="form-label">Adres</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-map"></i>
                    </span>
                    <textarea asp-for="Adres" class="form-control" rows="3" placeholder="Adres giriniz."></textarea>
                </div>
                <span asp-validation-for="Adres" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2 mb-3">
                <button type="submit" class="btn btn-warning">
                    Güncelle
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }   

    <script>
        const ilSelect = document.getElementById("ilSelect");
        const ilceSelect = document.getElementById("ilceSelect");

        ilSelect.addEventListener("change", function() {

            const ilId = this.value;

            ilceSelect.innerHTML =
                '<option value="">İlçe Seçiniz</option>';

            if (ilId === "") {
                return;
            }

            fetch('/Cari/IlceleriGetir?ilId=' + ilId)
                .then(response => response.json())
                .then(data => {

                    data.forEach(function(ilce) {

                        const option =
                            document.createElement("option");

                        option.value = ilce.ilceId;
                        option.textContent = ilce.ilceAdi;

                        ilceSelect.appendChild(option);
                    });

                });
        });
    </script>
}